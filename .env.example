# Copy to .env.local (same folder) and fill in. .env.local is ignored by git.

# Local model through Ollama. Leave as is if you pulled the recommended model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/second-state/Bielik-4.5B-v3.0-Instruct-GGUF:Q4_K_M
OLLAMA_CTX=4096
LLM_TIMEOUT=120
# Set to 1 to force the rules-and-templates mode (no model).
LLM_DISABLED=0

# Mailbox for the mail mole (read-only IMAP). For Gmail use an app password, not your normal password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_DAYS=14
IMAP_LIMIT=30

