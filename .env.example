# Backend reads these from the environment.
OLLAMA_URL=http://localhost:11434
# Exact tag of the pulled model; if it is missing, the first local "qwen" model is used.
OLLAMA_MODEL=qwen3.6
LLM_TIMEOUT=60
# Set to 1 to force the rules-and-templates mode (no model).
LLM_DISABLED=0
DB_PATH=./cyberkret.db
